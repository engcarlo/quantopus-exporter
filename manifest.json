{
  "manifest_version": 3,
  "name": "Quantopus Exporter: exporte conversas do WhatsApp Web",
  "short_name": "Quantopus Exporter",
  "version": "1.2.0",
  "description": "Exporte a conversa aberta no WhatsApp Web para TXT, HTML, CSV ou JSON. 100% local. Não afiliada ao WhatsApp ou à Meta.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["scripting", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quantopus Exporter",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
